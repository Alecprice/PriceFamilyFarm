# Public site URL used for canonical metadata, sitemap, and sharing cards.
NEXT_PUBLIC_SITE_URL=https://price-family-farm.alecjprice.com

# Web3Forms browser access key. This value is visible in the built JavaScript,
# so it is NOT a server secret. Keep the real value out of source control.
# If the Web3Forms account has a paid plan, enable Restrict to Domain for:
#   price-family-farm.alecjprice.com
# On the free plan, keep the provider spam protections + botcheck enabled and
# rotate this browser-visible identifier if it starts receiving abuse.
NEXT_PUBLIC_WEB3FORMS_ACCESS_KEY=
